{
  "manifest_version": 3,
  "name": "Tab Manager Pro",
  "short_name": "TabManager",
  "author": "Sandesh Patel",
  "version": "2.1.0",
  "description": "Tab Manager Pro: group tabs, close duplicates, save workspaces, snooze tabs, and hibernate idle tabs in Chrome & Firefox.",
  "homepage_url": "https://github.com/sandeshPatel06/tab-manager-pro",
  "offline_enabled": true,
  "browser_specific_settings": {
    "gecko": {
      "id": "tabmanager-pro-sandesh@patel.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["interaction"]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Manager Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "group-tabs": {
      "description": "Group tabs using current group preset",
      "suggested_key": {
        "default": "Ctrl+Shift+G"
      }
    },
    "remove-duplicates": {
      "description": "Remove duplicate tabs using current rules",
      "suggested_key": {
        "default": "Ctrl+Shift+D"
      }
    },
    "undo-last-removal": {
      "description": "Undo last duplicate cleanup",
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      }
    }
  }
}